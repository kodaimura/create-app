#!/usr/bin/env bash

set -euo pipefail

BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)
SCRIPT_COMMAND="$ROOT_DIR/lib/script.sh"
WEBSCAF_COMMAND="$ROOT_DIR/vendor/webscaf/setup.sh"

usage() {
  cat <<'EOF'
Usage:
  mkscaf
  mkscaf script [language project-name [output-directory]]
  mkscaf script patterns
  mkscaf web [pattern project-name [output-directory]]
  mkscaf web patterns
  mkscaf legacy laravel

Examples:
  mkscaf script python my-script
  mkscaf web fast-react my-app
  mkscaf web
EOF
}

choose_project_type() {
  echo "Select a project type:"
  echo "  1) Script"
  echo "  2) Web application"
  printf "Enter number [1-2]: "
  read -r choice

  case "$choice" in
    1)
      export MKSCAF_SCRIPT_COMMAND_NAME="mkscaf script"
      exec "$SCRIPT_COMMAND"
      ;;
    2)
      export WEBSCAF_COMMAND_NAME="mkscaf web"
      exec "$WEBSCAF_COMMAND"
      ;;
    *)
      echo "Error: enter a number between 1 and 2." >&2
      exit 1
      ;;
  esac
}

case "${1:-}" in
  "")
    choose_project_type
    ;;
  -h|--help|help)
    usage
    ;;
  script)
    shift
    export MKSCAF_SCRIPT_COMMAND_NAME="mkscaf script"
    exec "$SCRIPT_COMMAND" "$@"
    ;;
  web)
    shift
    export WEBSCAF_COMMAND_NAME="mkscaf web"
    exec "$WEBSCAF_COMMAND" "$@"
    ;;
  legacy)
    if [ "${2:-}" != "laravel" ] || [ "$#" -ne 2 ]; then
      usage >&2
      exit 1
    fi
    exec "$ROOT_DIR/sh/web-laravel.sh"
    ;;
  *)
    echo "Error: unknown command '$1'." >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
